{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-ai-agent-option1",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-17",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.html"],
      "fallthrough": true
    }
  ],
  "workers_dev": true,
  "vars": {
    "CHAT_MODEL": "@cf/zai-org/glm-4.7-flash"
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "vectorize": [
    {
      "binding": "FAQ_INDEX",
      "index_name": "faq-index",
      "remote": true
    }
  ]
}
