{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-ai-agent-option1-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-17",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.html"],
      "fallthrough": true
    }
  ],
  "vars": {
    "LOCAL_CLOUDFLARE_REST": "true"
  }
}
